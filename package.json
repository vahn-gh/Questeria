{
  "name": "questeria",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "preinstall": "node scripts/setupLibrary.js",
    "ios": "react-native run-ios",
    "lint": "yarn lint:packagejson && yarn tsc && yarn _prettier --check && yarn lint:ox",
    "lint:packagejson": "node scripts/validatePackagejson.js",
    "lint:ox": "oxlint .",
    "start": "react-native start",
    "test": "jest",
    "_prettier": "prettier 'scripts/**/*.js' '{__tests__,src}/**/*.{js,ts,tsx,scss,css,json}' --config .prettierrc",
    "format": "yarn _prettier --write"
  },
  "dependencies": {
    "@abraham/reflection": "0.13.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/native": "7.2.4",
    "@react-navigation/native-stack": "7.15.1",
    "mobx": "7.0.5",
    "mobx-react-lite": "5.1.0",
    "nanoid": "3.3.11",
    "patch-package": "8.0.1",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "3.0.2",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-pixelkit": "link:./libraries/react-native-pixelkit",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.27.0",
    "react-native-svg": "15.15.5",
    "react-native-unistyles": "3.2.5",
    "react-native-worklets": "0.12.1",
    "realm": "20.2.0"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/preset-env": "7.25.3",
    "@babel/runtime": "7.25.0",
    "@commitlint/config-conventional": "21.2.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "29.5.13",
    "@types/react": "19.2.0",
    "@types/react-test-renderer": "19.1.0",
    "babel-plugin-module-resolver": "5.0.2",
    "commitlint": "21.2.1",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-react-native": "5.0.0",
    "eslint-plugin-standard": "5.0.0",
    "jest": "29.6.3",
    "lefthook": "2.1.10",
    "oxlint": "1.85.0",
    "prettier": "3.6.2",
    "react-native-haptic-feedback": "3.0.0",
    "react-native-svg-transformer": "1.5.3",
    "react-test-renderer": "19.2.3",
    "typescript": "5.8.3"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "subject-case": [
        0
      ]
    }
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
